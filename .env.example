# ===== 数据库（PostgreSQL）=====
DB_USER=ehs
DB_PASSWORD=请改成强密码
DB_NAME=ehs
# 本地裸跑（npm run start / drizzle-kit push）用的数据库连接串。
# 把"你的密码"换成上面 DB_PASSWORD 的值即可。
# 注意：docker 部署时这个变量由 docker-compose.yml 自动覆盖，无需手动填。
DATABASE_URL=postgresql://ehs:你的密码@localhost:5432/ehs

# ===== 后端 =====
# 对外公网地址（用于生成微信扫码上报二维码、邮件链接等）
PUBLIC_BASE_URL=http://你的服务器IP:8010
# JWT 密钥，务必改掉，建议用 long random string
JWT_SECRET=请改成一段足够长的随机字符串
JWT_EXPIRES_IN=7d
# 管理员初始密码（首次登录需修改）
ADMIN_PASSWORD=Admin@123456
FRONTEND_ORIGIN=http://你的服务器IP:8010

# ===== AI（默认 DeepSeek，可换）=====
AI_PROVIDER=deepseek
AI_API_KEY=你的DeepSeek_API_Key
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ===== OCR（阿里云）=====
OCR_PROVIDER=aliyun
ALIYUN_OCR_ACCESS_KEY_ID=你的阿里云AccessKeyId
ALIYUN_OCR_ACCESS_KEY_SECRET=你的阿里云AccessKeySecret
ALIYUN_OCR_REGION=cn-shanghai

# ===== 飞书多维表格备份（可选，留空则只提供下载备份）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 是否每天定时自动备份到飞书（需要上面四项都填）
BACKUP_CRON_ENABLED=false
